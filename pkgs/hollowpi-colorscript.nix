{ writeShellScriptBin, ... }:
writeShellScriptBin "hollowpi-colorscript" ''
  initializeANSI()
  {
    esc=$(printf '\033')
    reset="''${esc}[0m"
    g1="''${esc}[38;2;94;129;172m"
    g2="''${esc}[38;2;111;132;172m"
    g3="''${esc}[38;2;128;134;172m"
    g4="''${esc}[38;2;146;137;172m"
    g5="''${esc}[38;2;163;139;173m"
    g6="''${esc}[38;2;180;142;173m"
  }

  initializeANSI

  cat << EOF
  ''${g1}   ▄▄▄  ▄▄▄       ▄▄ ▄▄                     ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄''${reset}
  ''${g2}  █▀██  ██         ██ ██                   █▀▀███▀▀▀▀███▀▀  ''${reset}
  ''${g3}    ██  ██         ██ ██                      ███    ███    ''${reset}
  ''${g4}    ██████   ▄███▄ ██ ██ ▄███▄▀█▄ █▄ ██▀      ███    ███    ''${reset}
  ''${g5}    ██  ██   ██ ██ ██ ██ ██ ██ ██▄██▄██       ███    ███    ''${reset}
  ''${g6}  ▀██▀  ▀██▄▄▀███▀▄██▄██▄▀███▀  ▀██▀██▀       ▀███▄  ▀███▄  ''${reset}
  EOF
''
