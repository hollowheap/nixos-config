{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#000000",
    "bgPanel": "#2e2e2e",
    "fg": "#ffffff",
    "fgSubtle": "#e0e0e0",
    "fgMuted": "#555555",
    "red": "{{color9}}",
    "orange": "{{color9}}",
    "yellow": "{{color11}}",
    "green": "{{color10}}",
    "cyan": "{{color14}}",
    "blue": "{{color12}}",
    "magenta": "{{color13}}"
  },
  "theme": {
    "primary": "blue",
    "secondary": "magenta",
    "accent": "cyan",
    "error": "red",
    "warning": "yellow",
    "success": "green",
    "info": "blue",
    "text": "fg",
    "textMuted": "fgMuted",
    "background": "bg",
    "backgroundPanel": "bgPanel",
    "backgroundElement": "bgPanel",
    "border": "bgPanel",
    "borderActive": "fgMuted",
    "borderSubtle": "bgPanel",
    "diffAdded": "green",
    "diffRemoved": "red",
    "diffContext": "fgMuted",
    "diffHunkHeader": "fgMuted",
    "diffHighlightAdded": "green",
    "diffHighlightRemoved": "red",
    "diffAddedBg": "bgPanel",
    "diffRemovedBg": "bgPanel",
    "diffContextBg": "bg",
    "diffLineNumber": "bgPanel",
    "diffAddedLineNumberBg": "bgPanel",
    "diffRemovedLineNumberBg": "bgPanel",
    "markdownText": "fg",
    "markdownHeading": "blue",
    "markdownLink": "magenta",
    "markdownLinkText": "cyan",
    "markdownCode": "green",
    "markdownBlockQuote": "fgMuted",
    "markdownEmph": "orange",
    "markdownStrong": "yellow",
    "markdownHorizontalRule": "fgMuted",
    "markdownListItem": "blue",
    "markdownListEnumeration": "cyan",
    "markdownImage": "magenta",
    "markdownImageText": "cyan",
    "markdownCodeBlock": "fg",
    "syntaxComment": "fgMuted",
    "syntaxKeyword": "magenta",
    "syntaxFunction": "blue",
    "syntaxVariable": "cyan",
    "syntaxString": "green",
    "syntaxNumber": "orange",
    "syntaxType": "cyan",
    "syntaxOperator": "magenta",
    "syntaxPunctuation": "fg"
  }
}
