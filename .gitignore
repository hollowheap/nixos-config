# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore untracked data and certificates
data/

# Python cache
__pycache__/
*.pyc

# Private mail accounts
home/modules/programs/accounts.local.nix

# Rust build output for local review tooling
pkgs/ui-scrape/target/
